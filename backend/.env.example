# Supabase (PostgreSQL) connection settings for RunForge backend
# Copy this file to ".env" (or export these as real environment variables)
# and fill in your actual Supabase project values. Never commit real secrets.
# Spring loads backend/.env automatically (see spring.config.import in application.properties).
#
# NOTE: SUPABASE_DB_URL must be a JDBC URL (jdbc:postgresql://...),
# NOT the project/API URL (https://<project-ref>.supabase.co).
# Get it from the Supabase dashboard: Connect -> Session pooler.

# Session pooler (IPv4-compatible) - recommended for local development:
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.<project-ref>

# Or direct connection (IPv6 only unless the IPv4 add-on is enabled):
# SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DB_USER=postgres

# Database password (Project Settings -> Database), not the API key:
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Hibernate DDL strategy: "update" keeps schema in sync automatically (dev),
# use "validate" or "none" once the schema is stable in production.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Seed data (data.sql) execution mode: "never" (default, safe for existing
# data), "always" to (re)insert seed rows on every startup.
SPRING_SQL_INIT_MODE=never
